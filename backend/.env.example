# Configuracion del backend de MUSICA EPICA.
# Copia este archivo a "backend/.env" y ajusta los valores si es necesario.
# Estas credenciales NUNCA se envian al frontend: solo las usa Python.

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sam
MYSQL_PASSWORD=1234
MYSQL_DATABASE=musica_epica

# --- Algoritmo (mismos valores que el recomendador.py original) ---
SIMILITUD_MINIMA=0.30
CANTIDAD_POR_DEFECTO=5

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Origenes del frontend permitidos (separados por comas, sin usar "*").
# 5173 = servidor de Vite, 4173 = npm run preview, 5500 = Open with Live Server,
# 8000 = la propia API sirviendo la web (http://localhost:8000).
# Si abres Front/index.html con doble clic (file://), el navegador manda el
# origen "null" y lo bloquea: en ese caso usa Live Server o "npm run dev".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# --- Busqueda ---
LIMITE_BUSQUEDA=20
CANTIDAD_MAXIMA=20
