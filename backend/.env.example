# Configuracion del backend de MUSICA EPICA.
# Copia este archivo a "backend/.env" y ajusta los valores si es necesario.
# Estas credenciales NUNCA se envian al frontend: solo las usa Python.

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sam
MYSQL_PASSWORD=1234
MYSQL_DATABASE=musica_epica

# --- Algoritmo (mismos valores que el recomendador.py original) ---
SIMILITUD_MINIMA=0.30
CANTIDAD_POR_DEFECTO=5

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Origenes del frontend permitidos (separados por comas, sin usar "*").
# 5173 = servidor de Vite, 4173 = npm run preview, 5500 = Open with Live Server,
# 8000 = la propia API sirviendo la web (http://localhost:8000).
# Si publicas el frontend en Netlify, anade el dominio aqui o usa la regex:
# CORS_ORIGIN_REGEX=https://.*\.netlify\.app
# Si abres Front/index.html con doble clic (file://), el navegador manda el
# origen "null" y lo bloquea: en ese caso usa Live Server o "npm run dev".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# --- Busqueda ---
LIMITE_BUSQUEDA=20
CANTIDAD_MAXIMA=20

# ============================================================
#  Autenticacion (OAuth) - TODO, desactivado por defecto
# ============================================================
# IMPORTANTE: estas credenciales viven SOLO en el backend. Nunca van en
# Front/.env ni en el codigo de React: todo lo que se envia al navegador es
# publico, y con un "client secret" en el frontend cualquiera podria suplantar
# tu cuenta.
#
# El flujo real es:
#   React pide la URL de login -> el backend redirige al proveedor
#   -> el proveedor devuelve un "code" -> el backend lo cambia por un token
#   -> el backend guarda la sesion y React recibe un simple "estoy dentro".
#
# Cada credencial se consigue en el panel del proveedor (ver README.md,
# seccion "Autenticacion"):
#   GOOGLE_*  -> console.cloud.google.com  (Google Cloud > APIs & Services)
#   SPOTIFY_* -> developer.spotify.com/dashboard
#   APPLE_*   -> developer.apple.com     (Sign in with Apple, requiere cuenta
#                                        de pago: 99 USD/ano)
#   SMTP_*    -> tu proveedor de correo (Gmail, Mailgun, Resend, ...)

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=""

# Correo electronico (envio de enlaces de acceso)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
