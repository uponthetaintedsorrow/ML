# Configuracion del frontend de MUSICA EPICA.
# Copia este archivo a ".env" solo si los valores por defecto no te sirven.

# URL de la API Python (backend/api.py).
# El frontend NUNCA se conecta directamente a MySQL: solo habla con esta API.
VITE_API_URL=http://localhost:8000

# Tiempo maximo de espera de las peticiones, en ms.
VITE_API_TIMEOUT=20000

# Cuantas recomendaciones se piden al pulsar "Recomendar".
VITE_RECOMMENDATION_COUNT=5
